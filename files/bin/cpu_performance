#!/bin/sh

set -eu

ME="${0##*/}"
GOVERNORS=/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors

die() { echo "$ME: $*" >&2; exit 1; }

pick() {
	local governors="$(tr ' ' '\n' < "$GOVERNORS")"
	local g

	for g; do
		if echo "$governors" | grep -q "^$g$"; then
			echo "$g"
			return
		fi
	done
}

case "$ME" in
	*_performance) governor=$(pick performance);;
	*_powersave) governor=$(pick powersave ondemand);;
	*) die "unknown command";;
esac

[ -n "$governor" ] || die "no suitable governor in: $(cat "$GOVERNORS")"

for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
	sudo -- sh -c "echo \"$governor\" > \"$f\""
done
